{
  "name": "nm",
  "module": "src/index.ts",
  "description": "고음질 무료 음악 봇, NM",
  "type": "module",
  "private": true,
  "version": "2.11.8",
  "scripts": {
    "preinstall": "npx only-allow bun",
    "start": "NODE_ENV=production bun run ./src/index.ts",
    "dev": "NODE_ENV=development bun --watch run ./src/index.ts",
    "deploy-commands": "bun run ./src/deploy.ts",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:once": "bun run db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "^1.3.14",
    "@types/get-image-colors": "^4.0.5",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "@types/luxon": "^3.7.2",
    "chalk": "^5.6.2",
    "discord.js": "^14.26.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "get-image-colors": "^4.0.1",
    "koreanbots": "^3.2.1",
    "luxon": "^3.7.2",
    "postgres": "^3.4.9",
    "shoukaku": "^4.3.0",
    "undici": "^8.6.0",
    "zod": "^4.5.4"
  }
}
